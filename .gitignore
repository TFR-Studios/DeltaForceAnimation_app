# 依赖与前端构建产物
node_modules/
dist/

# 改版前的源码快照(backup/ui-revamp-*):开发留档,不属于仓库内容
backup/

# 编辑器与本机配置
.idea/
.vscode/
*.iml

# Android 签名材料(绝不能进公开仓库;gen/android/.gitignore 里有同名规则,这里是双保险)
*.keystore
*.jks
keystore.properties
key.properties

# Tauri v2(Rust)构建产物:src-tauri/target 会膨胀到数 GB,必须忽略
/src-tauri/target/
/src-tauri/gen/schemas/

# 桌面应用打包产物(免安装目录 / 便携版 exe / 自检输出)
release/
# CI / 本地打出来的待发布产物(发完之后就没有用了)
/release-assets/
# 发布自检下载/解包出来的目录(同理:几百 MB 的 exe/zip,不该进仓库)。
# 之前漏了这条,曾经把一个 391 MB 的未推送提交带进本地历史(2b32297),详见 docs/RELEASE_NOTES_v1.0.5.md。
/release-assets-check/
# 注意:build/icon.ico / build/icon.png / build/splash.bmp **要提交**。
# 它们是打包的输入(不是产物),而且由 npm run icons 生成时需要真的拉起 Electron;
# CI 的 Windows runner 上没有可用的图形会话,让流水线依赖这一步很脆。
# splash.bmp 是便携版解包时显示的那张启动图(见 electron/make-icons.mjs 后半段),
# 换 logo 或改 electron/portable-splash.html 之后再本地跑一次 npm run icons,把这三个文件一起提交即可。

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 动画备份文件(仅保留主文件 animation_data.json)
animations/animation_1/animation_data.*.json

# 验证脚本生成的测试视频
tools/*.avi

# 用户导出的视频(避免提交仓库)
/*.avi

# 导出产物的兜底目录:正常情况下产物落在系统「下载」文件夹的应用子目录里,
# 只有系统下载目录不可用时才会退回软件目录旁的 downloads/ —— 两种情况都不该进仓库。
/downloads/

# 下载历史清单(正常在 %APPDATA% 下;这里是防御性忽略)
download-history.json

# 调试转储(动辄 GB 级,不要提交)
tools/.frames.raw

# AE video-layer footage inside animations/animation_4 (unused by the site, can be GBs)
animations/animation_4/images/*.mp4

# AE video-layer footage inside animations/animation_6 (the loader drops those layers, can be GBs)
animations/animation_6/images/*.mp4
