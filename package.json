{
  "name": "delta-force-animation-editor-desktop",
  "private": true,
  "version": "1.0.2",
  "description": "三角洲行动动画编辑器 · Windows 桌面版(Electron):内置八套游戏动画的 Lottie 预览 / 编辑 / 视频导出",
  "author": "TFR-Studios",
  "license": "GPL-3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:start": "electron .",
    "app:dev": "node scripts/dev-app.mjs",
    "app:smoke": "electron . --smoke --smoke-out=release/smoke",
    "app:smoke:export": "electron . --smoke --smoke-export=mp4 --smoke-out=release/smoke-export",
    "icons": "electron electron/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win dir --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "lottie-web": "^5.13.0",
    "mp4-muxer": "^5.2.2",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "top.tfrstudio.dfae",
    "productName": "三角洲行动动画编辑器",
    "copyright": "Copyright © 2026 TFR-Studios · 编辑器代码 GPL-3.0,动画素材版权归原游戏所有",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "npmRebuild": false,
    "compression": "normal",
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false,
      "artifactName": "DeltaForceAnimationEditor-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DeltaForceAnimationEditor-Setup-${version}.${ext}",
      "shortcutName": "三角洲行动动画编辑器",
      "uninstallDisplayName": "三角洲行动动画编辑器 ${version}",
      "installerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "DeltaForceAnimationEditor-Portable-${version}.exe",
      "unpackDirName": "DeltaForceAnimationEditor",
      "requestExecutionLevel": "user",
      "splashImage": "build/splash.bmp"
    }
  },
  "dependencies": {
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@fluentui/web-components": "^3.1.3"
  }
}
